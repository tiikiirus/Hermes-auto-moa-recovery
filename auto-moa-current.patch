diff --git a/agent/moa_auto_router.py b/agent/moa_auto_router.py
new file mode 100644
index 000000000..ae6729e4c
--- /dev/null
+++ b/agent/moa_auto_router.py
@@ -0,0 +1,471 @@
+"""Auto-MoA route selection helpers.
+
+These helpers let a virtual ``auto_moa`` preset resolve to a concrete
+preset per user turn, based on the current message content.  The router
+is intentionally lightweight: it does not fan out references itself, it
+only chooses which preset ``MoAChatCompletions.create()`` should use for
+the current turn.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from typing import Any
+
+# Visual part types that indicate the user sent an image/video
+_VISUAL_PART_TYPES = {
+    "image",
+    "image_url",
+    "input_image",
+    "input_video",
+    "video",
+    "video_url",
+}
+
+# Token patterns for each category, with word boundaries to avoid false positives.
+# Each pattern matches whole words only (e.g., "code" matches "code" but not "decode").
+_TOKEN_PATTERNS: dict[str, re.Pattern[str]] = {
+    "code": re.compile(
+        r"\b(code|function|script|program|implement|refactor|bug|error|"
+        r"coding|programming|method|class|module|api)\b",
+        re.IGNORECASE,
+    ),
+    "logic": re.compile(
+        r"\b(explain|why|reason|logic|compare|analyze|analysis|summarize|summary|"
+        r"comparison|evaluate|evaluation|assess|assessment|review|understand|"
+        r"describe|description|define|definition|clarify|clarification)\b",
+        re.IGNORECASE,
+    ),
+    "code_visual": re.compile(
+        r"\b(plot|chart|graph|visualize|diagram|draw|drawing|sketch|"
+        r"illustrate|illustration|render|rendering|design|layout|wireframe|"
+        r"mockup|prototype|figma|css|html|ui|ux|interface|screen|component|"
+        r"график|диаграмма|схема|чертёж|макет|прототип|интерфейс|экран|компонент|"
+        r"нарисуй|рисуй)\b",
+        re.IGNORECASE,
+    ),
+    "logic_visual": re.compile(
+        r"\b(image|photo|picture|screenshot|video|visual|graphic|figure|"
+        r"illustration|diagram|flowchart|map|heatmap|scatter|bar|line|pie|"
+        r"histogram|distribution|trend|correlation|pattern)\b",
+        re.IGNORECASE,
+    ),
+    # Russian language tokens (project convention: Russian user comms)
+    # Use prefix matching (no trailing \b) to handle word forms:
+    # "функци" matches "функция", "функцию", "функции", "функций"
+    "code_ru": re.compile(
+        r"\b(код|функци|скрипт|программ|рефактор|баг|ошиб|реализ|"
+        r"метод|класс|модул|api|кодир|программирован)",
+        re.IGNORECASE,
+    ),
+    "logic_ru": re.compile(
+        r"\b(объясни|почему|причина|логика|сравни|анализ|анализируй|"
+        r"резюме|саммари|сравнен|оценк|оцени|ревью|обзор|пойми|"
+        r"описать|описание|определить|определение|уточни|уточнение)",
+        re.IGNORECASE,
+    ),
+    "visual_ru": re.compile(
+        r"\b(картинк|изображение|фото|скриншот|видео|визуал|график|"
+        r"диаграмма|рисуй|нарисуй|чертёж|черти|схема|карта|"
+        r"интерфейс|экран|компонент|дизайн|макет|прототип)",
+        re.IGNORECASE,
+    ),
+}
+
+
+def _has_token(text: str, category: str) -> bool:
+    """Check if text contains any token for the given category."""
+    pattern = _TOKEN_PATTERNS.get(category)
+    return pattern.search(text) is not None if pattern else False
+
+
+def _has_any_token(text: str, *categories: str) -> bool:
+    """Check if text contains any token for any of the given categories."""
+    return any(_has_token(text, cat) for cat in categories)
+
+
+def _active_turn_visual_parts(
+    messages: list[dict[str, Any]],
+    context_messages: int = 8,
+) -> list[dict[str, Any]]:
+    """Copy current/recent user visual blocks for compression rebases."""
+    conversation = [
+        message
+        for message in messages
+        if message.get("role") in {"user", "assistant"}
+    ][-(max(1, context_messages) + 1) :]
+    visual_parts: list[dict[str, Any]] = []
+    for message in conversation:
+        if message.get("role") != "user":
+            continue
+        content = message.get("content")
+        content_parts = (
+            [content]
+            if isinstance(content, dict)
+            else content
+            if isinstance(content, (list, tuple))
+            else []
+        )
+        for part in content_parts:
+            if (
+                isinstance(part, dict)
+                and str(part.get("type") or "").lower() in _VISUAL_PART_TYPES
+                and part not in visual_parts
+            ):
+                visual_parts.append(dict(part))
+    return visual_parts
+
+
+def _has_recent_visual_parts(
+    messages: list[dict[str, Any]],
+    context_messages: int = 8,
+) -> bool:
+    """True if a visual block exists in recent user turns.
+
+    Used for visual-category stickiness: a follow-up without a newly
+    attached image ("делай", "а это точно?") still belongs to the visual
+    task while the screenshot is inside the recent context window.
+    Bounded by the window — aged-out visuals fall back to ``False``.
+    """
+    try:
+        return bool(_active_turn_visual_parts(messages, context_messages))
+    except Exception:
+        return False
+
+
+def _restore_active_turn_visual_parts(
+    messages: list[dict[str, Any]],
+    visual_parts: Any,
+) -> None:
+    """Restore omitted active-turn pixels to the acting aggregator transcript."""
+    if not isinstance(visual_parts, list) or not visual_parts:
+        return
+    parts = [dict(part) for part in visual_parts if isinstance(part, dict)]
+    if not parts:
+        return
+    for index in range(len(messages) - 1, -1, -1):
+        message = messages[index]
+        if message.get("role") != "user":
+            continue
+        content = message.get("content")
+        if isinstance(content, list):
+            existing = list(content)
+        elif isinstance(content, str):
+            existing = [{"type": "text", "text": content}]
+        elif content is None:
+            existing = []
+        else:
+            existing = [content]
+        message["content"] = [
+            *existing,
+            *(part for part in parts if part not in existing),
+        ]
+        return
+    messages.append({"role": "user", "content": parts})
+
+
+def auto_route_turn_fingerprint(messages: list[dict[str, Any]]) -> str:
+    """Return a stable fingerprint for the current user turn.
+
+    Uses only text content to avoid serializing large base64 payloads.
+    """
+    user_messages = [
+        message for message in messages if message.get("role") == "user"
+    ]
+    last_user = user_messages[-1] if user_messages else {}
+
+    # Extract only text parts for fingerprinting (avoid base64 bloat)
+    content = last_user.get("content")
+    if isinstance(content, list):
+        text_parts = [
+            part.get("text", "")
+            for part in content
+            if isinstance(part, dict) and part.get("type") == "text"
+        ]
+        text = " ".join(text_parts)
+    else:
+        text = str(content or "")
+
+    # Include visual part types in fingerprint (but not the data)
+    visual_types = sorted(
+        str(part.get("type") or "").lower()
+        for part in (content if isinstance(content, list) else [])
+        if isinstance(part, dict) and part.get("type", "").lower() in _VISUAL_PART_TYPES
+    )
+    if visual_types:
+        text += "|" + ",".join(visual_types)
+
+    return hashlib.sha256(text.encode("utf-8", errors="ignore")).hexdigest()
+
+
+class AutoRouteDecision:
+    """Resolved auto-route target for one user turn."""
+
+    __slots__ = ("preset", "category", "reason", "complexity")
+
+    def __init__(
+        self,
+        preset: str,
+        category: str,
+        reason: str,
+        complexity: str = "standard",
+    ) -> None:
+        self.preset = preset
+        self.category = category
+        self.reason = reason
+        self.complexity = complexity
+
+
+# Marker appended by context_references when @url/@file material is attached
+# to a user turn. Routing must match on the user's own words: a multi-thousand
+# token attached page otherwise out-votes the request (observed: "проверь
+# аномалию" + attached page routed code_visual on stray page tokens).
+_ATTACHED_CONTEXT_MARKER = "--- Attached Context ---"
+
+
+def _extract_text(last_user: dict[str, Any]) -> str:
+    """Extract text content from a user message, handling both string and list formats.
+
+    Attached @url/@file context (everything from the marker on) is excluded:
+    it describes referenced material, not the request itself. The fingerprint
+    function intentionally keeps the full text (cache correctness) — only
+    routing text is stripped here.
+    """
+    content = last_user.get("content")
+    if isinstance(content, list):
+        text = " ".join(
+            part.get("text", "")
+            for part in content
+            if isinstance(part, dict) and part.get("type") == "text"
+        )
+    else:
+        text = str(content or "")
+    return text.split(_ATTACHED_CONTEXT_MARKER, 1)[0]
+
+
+def _has_visual_content(last_user: dict[str, Any]) -> bool:
+    """Check if the message contains visual parts (image/video)."""
+    content = last_user.get("content")
+    if not isinstance(content, list):
+        return False
+    return any(
+        isinstance(part, dict)
+        and str(part.get("type") or "").lower() in _VISUAL_PART_TYPES
+        for part in content
+    )
+
+
+def select_auto_moa_route(
+    messages: list[dict[str, Any]],
+    auto_route: dict[str, Any],
+    previous_category: str | None = None,
+) -> AutoRouteDecision:
+    """Pick a concrete preset for the current user turn.
+
+    The routing table is a mapping from category keywords to preset names.
+    ``auto_route`` is the raw ``auto_route`` block from a preset config.
+
+    Routing priority:
+    1. Visual content (image/video) → visual category
+    2. Code tokens → code category
+    3. Logic tokens → logic category
+    4. Previous category stickiness (for follow-ups)
+    5. Fallback
+    """
+    if not isinstance(auto_route, dict):
+        return AutoRouteDecision(
+            preset="default",
+            category="fallback",
+            reason="invalid auto_route block",
+        )
+
+    last_user = next(
+        (
+            message
+            for message in reversed(messages)
+            if message.get("role") == "user"
+        ),
+        {},
+    )
+
+    text = _extract_text(last_user).lower()
+    has_visual = _has_visual_content(last_user)
+    fallback = str(auto_route.get("fallback") or "default")
+
+    # Priority 1: Visual content (check first, overrides stickiness)
+    if has_visual or _has_any_token(text, "code_visual", "logic_visual", "visual_ru"):
+        if _has_any_token(text, "code_visual", "code_ru") or _has_token(text, "code"):
+            category = "code_visual"
+        else:
+            category = "logic_visual"
+        preset = str(auto_route.get(category) or auto_route.get("code_visual") or fallback)
+
+    # Priority 2: Code tokens
+    elif _has_any_token(text, "code", "code_ru"):
+        category = "code"
+        preset = str(auto_route.get("code") or fallback)
+
+    # Priority 3: Logic tokens
+    elif _has_any_token(text, "logic", "logic_ru"):
+        category = "logic"
+        preset = str(auto_route.get("logic") or fallback)
+
+    # Priority 4: Previous category stickiness (for short follow-ups)
+    elif previous_category == "logic" and len(text.split()) <= 3:
+        category = "logic"
+        preset = str(auto_route.get("logic") or fallback)
+    elif previous_category == "code" and len(text.split()) <= 3:
+        category = "code"
+        preset = str(auto_route.get("code") or fallback)
+    elif previous_category in ("logic_visual", "code_visual") and (
+        has_visual or _has_recent_visual_parts(messages)
+    ):
+        # Visual stickiness: a follow-up without a newly attached image
+        # ("делай", "а это точно?") still belongs to the visual task while
+        # the screenshot is inside the recent context window. Explicit
+        # code/logic/visual tokens above already take precedence, and
+        # aged-out visuals (outside the window) fall through to fallback.
+        category = previous_category
+        preset = str(auto_route.get(category) or fallback)
+
+    # Priority 5: Fallback
+    else:
+        category = "fallback"
+        preset = fallback
+
+    reason = f"auto route → {category}"
+    return AutoRouteDecision(
+        preset=preset,
+        category=category,
+        reason=reason,
+        complexity=classify_turn_complexity(messages),
+    )
+
+
+# ---------------------------------------------------------------------------
+# Per-turn complexity → reasoning adequacy
+# ---------------------------------------------------------------------------
+# Static per-preset reasoning_effort over-spends on trivial follow-ups
+# ("ок", "делай") and under-spends on hard turns (screenshot + docs +
+# code). The router already extracts everything needed, so it also grades
+# the turn once; moa_loop only applies the grade to COPIES of slot dicts.
+
+_TRIVIAL_MAX_WORDS = 8
+_COMPLEX_LONG_WORDS = 100
+_COMPLEX_CODE_WORDS = 30
+
+# Must stay in sync with hermes_constants.parse_reasoning_effort levels.
+_EFFORT_ORDER = ("minimal", "low", "medium", "high", "xhigh", "max", "ultra")
+
+
+def _last_user_raw_text(messages: list[dict[str, Any]]) -> str:
+    """User words INCLUDING attached @url/@file context (for attachment detection)."""
+    last_user = next(
+        (
+            message
+            for message in reversed(messages)
+            if isinstance(message, dict) and message.get("role") == "user"
+        ),
+        {},
+    )
+    content = last_user.get("content")
+    if isinstance(content, list):
+        return " ".join(
+            part.get("text", "")
+            for part in content
+            if isinstance(part, dict) and part.get("type") == "text"
+        )
+    return str(content or "")
+
+
+def classify_turn_complexity(messages: list[dict[str, Any]]) -> str:
+    """Grade one user turn as "trivial" | "standard" | "complex".
+
+    - trivial: a few words, no visual, no attached context, no code —
+      e.g. "ок", "делай", "продолжай".
+    - complex: long text, or fresh visual, or attached context, or a
+      substantive code task — e.g. screenshot analysis with docs.
+    - standard: everything else.
+    """
+    last_user = next(
+        (
+            message
+            for message in reversed(messages)
+            if isinstance(message, dict) and message.get("role") == "user"
+        ),
+        {},
+    )
+    raw = _last_user_raw_text(messages)
+    has_attachment = _ATTACHED_CONTEXT_MARKER in raw
+    text = raw.split(_ATTACHED_CONTEXT_MARKER, 1)[0]
+    words = len(text.split())
+    has_visual = _has_visual_content(last_user)
+    has_code = _has_any_token(text, "code", "code_ru")
+    if (
+        words <= _TRIVIAL_MAX_WORDS
+        and not has_visual
+        and not has_attachment
+        and not has_code
+    ):
+        return "trivial"
+    if (
+        words > _COMPLEX_LONG_WORDS
+        or has_visual
+        or has_attachment
+        or (has_code and words > _COMPLEX_CODE_WORDS)
+    ):
+        return "complex"
+    return "standard"
+
+
+def _effort_index(level: Any) -> int | None:
+    """Position of a reasoning level in _EFFORT_ORDER, or None if not adjustable.
+
+    Disabled ("none"/False/...) and unrecognized values are NOT adjustable:
+    forcing "low" onto a deliberately disabled slot would enable reasoning
