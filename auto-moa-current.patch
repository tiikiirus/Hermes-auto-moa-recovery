index 000000000..daab8acb1
--- /dev/null
+++ b/tests/agent/test_moa_route_relay.py
@@ -0,0 +1,45 @@
+"""Tests for the ``moa.route`` relay contract."""
+from __future__ import annotations
+
+import pytest
+
+from agent.moa_loop import MoAChatCompletions
+
+
+def test_moa_route_relay_payload_contract():
+    """The ``moa.route`` event must preserve preset/reason for frontends."""
+    captured: list[tuple[str, dict]] = []
+
+    def _capture(event: str, **kwargs):
+        captured.append((event, kwargs))
+
+    facade = MoAChatCompletions("auto_moa", reference_callback=_capture)
+    facade._emit("moa.route", preset="code_preset", reason="auto route → code")
+
+    assert captured == [
+        (
+            "moa.route",
+            {
+                "preset": "code_preset",
+                "reason": "auto route → code",
+            },
+        )
+    ]
+
+
+def test_moa_route_relay_defaults_when_payload_missing():
+    """Missing route fields should still reach the callback as safe defaults."""
+    captured: list[tuple[str, dict]] = []
+
+    def _capture(event: str, **kwargs):
+        captured.append((event, kwargs))
+
+    facade = MoAChatCompletions("auto_moa", reference_callback=_capture)
+    facade._emit("moa.route")
+
+    assert captured == [
+        (
+            "moa.route",
+            {},
+        )
+    ]
diff --git a/tests/hermes_cli/test_moa_auto_route.py b/tests/hermes_cli/test_moa_auto_route.py
new file mode 100644
index 000000000..a0f1081da
--- /dev/null
+++ b/tests/hermes_cli/test_moa_auto_route.py
@@ -0,0 +1,138 @@
+"""Regression: auto_route must survive MoA preset normalization.
+
+The virtual ``auto_moa`` preset carries an ``auto_route`` table that the
+MoA loop reads to resolve a concrete preset per user turn.  ``normalize_moa_config``
+used to rebuild each preset from a fixed allow-list and silently dropped
+``auto_route``, which made ``MoAChatCompletions.create()`` raise
+``RuntimeError: MoA auto preset 'auto_moa' has an invalid auto_route``.
+"""
+
+import pytest
+from hermes_cli.moa_config import normalize_moa_config, resolve_moa_preset
+
+
+def _sample_raw() -> dict:
+    return {
+        "presets": {
+            "auto_moa": {
+                "auto_route": {
+                    "code": "code_logic_deep",
+                    "logic": "logic_deep",
+                    "code_visual": "code_visual_deep",
+                    "logic_visual": "logic_visual_deep",
+                    "fallback": "default",
+                    "context_messages": 8,
+                },
+                "reference_models": [
+                    {"provider": "nous", "model": "tencent/hy3:free", "enabled": True}
+                ],
+                "aggregator": {"provider": "nous", "model": "stepfun/step-3.7-flash:free"},
+                "enabled": True,
+            },
+            "default": {
+                "reference_models": [
+                    {"provider": "nous", "model": "x", "enabled": True}
+                ],
+                "aggregator": {"provider": "nous", "model": "y"},
+            },
+        }
+    }
+
+
+def test_normalize_moa_config_preserves_auto_route():
+    cfg = normalize_moa_config(_sample_raw())
+    preset = cfg["presets"]["auto_moa"]
+    assert isinstance(preset.get("auto_route"), dict), (
+        "auto_route must survive normalization as a dict"
+    )
+    assert preset["auto_route"]["logic"] == "logic_deep"
+    assert preset["auto_route"].get("context_messages") == 8
+
+
+def test_resolve_auto_moa_preset_keeps_auto_route_dict():
+    preset = resolve_moa_preset(_sample_raw(), "auto_moa")
+    assert isinstance(preset.get("auto_route"), dict), (
+        "resolve_moa_preset must return auto_route as a dict for auto_moa"
+    )
+    assert preset["auto_route"]["fallback"] == "default"
+
+
+def test_normalize_drops_non_dict_auto_route():
+    raw = _sample_raw()
+    raw["presets"]["auto_moa"]["auto_route"] = "not-a-dict"
+    cfg = normalize_moa_config(raw)
+    assert cfg["presets"]["auto_moa"].get("auto_route") is None
+
+
+@pytest.mark.parametrize(
+    "auto_route_config,expected_targets",
+    [
+        (
+            {
+                "code": "code_logic_deep",
+                "logic": "logic_deep",
+                "code_visual": "code_visual_deep",
+                "logic_visual": "logic_visual_deep",
+                "fallback": "default",
+            },
+            {"code_logic_deep", "logic_deep", "code_visual_deep", "logic_visual_deep", "default"},
+        ),
+        (
+            {
+                "code": "deepseek_code",
+                "logic": "o3_logic",
+                "code_visual": "gpt4v_visual",
+                "logic_visual": "gpt4v_visual",
+                "fallback": "default",
+            },
+            {"deepseek_code", "o3_logic", "gpt4v_visual", "default"},
+        ),
+    ],
+)
+def test_clean_auto_route_accepts_valid_configs(auto_route_config, expected_targets):
+    """Valid auto_route configs should survive normalization."""
+    from hermes_cli.moa_config import _clean_auto_route
+
+    result = _clean_auto_route(auto_route_config)
+    assert result is not None
+    # Check only string values (exclude context_messages which is an int)
+    string_values = {v for v in result.values() if isinstance(v, str)}
+    assert string_values == expected_targets
+
+
+@pytest.mark.parametrize(
+    "auto_route_config",
+    [
+        {"code": "", "logic": "l", "code_visual": "cv", "logic_visual": "lv", "fallback": "d"},
+        {"code": "c", "logic": "", "code_visual": "cv", "logic_visual": "lv", "fallback": "d"},
+        "string-auto-route",
+        None,
+        42,
+    ],
+)
+def test_clean_auto_route_rejects_invalid_configs(auto_route_config):
+    """Invalid auto_route configs should return None."""
+    from hermes_cli.moa_config import _clean_auto_route
+
+    result = _clean_auto_route(auto_route_config)
+    assert result is None
+
+
+def test_normalize_clamps_context_messages():
+    """context_messages must be clamped to [1, 20]."""
+    from hermes_cli.moa_config import _clean_auto_route
+
+    config = {
+        "code": "c",
+        "logic": "l",
+        "code_visual": "cv",
+        "logic_visual": "lv",
+        "fallback": "d",
+        "context_messages": 100,
+    }
+    result = _clean_auto_route(config)
+    assert result["context_messages"] == 20
+
+    config["context_messages"] = 0
+    result = _clean_auto_route(config)
+    assert result["context_messages"] == 1
