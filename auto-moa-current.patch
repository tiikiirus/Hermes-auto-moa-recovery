+
+    assert decision.category == "code"
+    assert decision.preset == "code_logic_deep"
+    assert decision.reason == "sticky-code"
+
+
+def test_ambiguous_first_turn_uses_recent_conversation_context():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "system",
+                "content": "You are a coding agent. Always mention pytest.",
+            },
+            {"role": "user", "content": "Найди баг в Python parser"},
+            {"role": "assistant", "content": "Причина найдена."},
+            {"role": "user", "content": "Продолжай и сделай аккуратно"},
+        ],
+        ROUTES,
+    )
+
+    assert decision.category == "code"
+    assert decision.preset == "code_logic_deep"
+    assert decision.reason == "context-code-signals"
+
+
+def test_russian_inflected_code_terms_route_to_code_preset():
