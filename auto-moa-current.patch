+class TestAdjustSlotsForComplexity:
+    """Effort scaling is monotonic, copy-only, and respects pins."""
+
+    def test_standard_returns_untouched_copies(self):
+        refs = [{"model": "m", "reasoning_effort": "medium"}]
+        agg = {"model": "a", "reasoning_effort": "high"}
+        new_refs, new_agg = adjust_slots_for_complexity(refs, agg, "standard")
+        assert new_refs == refs and new_agg == agg
+        assert new_refs is not refs and new_agg is not agg
+
+    def test_inputs_never_mutated(self):
+        refs = [{"model": "m", "reasoning_effort": "high"}]
+        agg = {"model": "a", "reasoning_effort": "high"}
+        adjust_slots_for_complexity(refs, agg, "trivial")
+        adjust_slots_for_complexity(refs, agg, "complex")
+        assert refs == [{"model": "m", "reasoning_effort": "high"}]
+        assert agg == {"model": "a", "reasoning_effort": "high"}
+
+    def test_trivial_downgrades_only(self):
+        refs = [
+            {"model": "a", "reasoning_effort": "medium"},
+            {"model": "b", "reasoning_effort": "low"},
+            {"model": "c", "reasoning_effort": "none"},
+            {"model": "d"},
+        ]
+        agg = {"model": "z", "reasoning_effort": "high"}
+        new_refs, new_agg = adjust_slots_for_complexity(refs, agg, "trivial")
+        assert [s.get("reasoning_effort") for s in new_refs] == [
+            "low",
+            "low",
+            "none",
+            None,
+        ]
+        assert new_agg["reasoning_effort"] == "medium"
+
+    def test_trivial_keeps_low_aggregator(self):
+        _, new_agg = adjust_slots_for_complexity(
+            [], {"model": "z", "reasoning_effort": "low"}, "trivial"
+        )
+        assert new_agg["reasoning_effort"] == "low"
+
+    def test_complex_upgrades_capped(self):
+        refs = [
+            {"model": "a", "reasoning_effort": "low"},
+            {"model": "b", "reasoning_effort": "medium"},
+            {"model": "c", "reasoning_effort": "high"},
+            {"model": "d", "reasoning_effort": "none"},
+            {"model": "e"},
+        ]
+        agg = {"model": "z", "reasoning_effort": "high"}
+        new_refs, new_agg = adjust_slots_for_complexity(refs, agg, "complex")
+        assert [s.get("reasoning_effort") for s in new_refs] == [
+            "medium",
+            "high",
+            "high",
+            "none",
+            None,
+        ]
+        assert new_agg["reasoning_effort"] == "xhigh"
+
+    def test_complex_keeps_max_aggregator(self):
+        _, new_agg = adjust_slots_for_complexity(
+            [], {"model": "z", "reasoning_effort": "max"}, "complex"
+        )
+        assert new_agg["reasoning_effort"] == "max"
+
+    def test_unpinned_aggregator_keeps_global_path(self):
+        _, new_agg = adjust_slots_for_complexity([], {"model": "z"}, "trivial")
+        assert "reasoning_effort" not in new_agg
