+                    min(idx + 1, _EFFORT_ORDER.index("high"))
+                ]
+        if "reasoning_effort" in agg:
+            idx = _effort_index(agg.get("reasoning_effort"))
+            if idx is not None and idx < _EFFORT_ORDER.index("xhigh"):
+                agg["reasoning_effort"] = "xhigh"
+    return refs, agg
