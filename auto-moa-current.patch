+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import yaml
+
+
+def _response(content: str):
+    message = SimpleNamespace(content=content, tool_calls=[])
+    choice = SimpleNamespace(message=message, finish_reason="stop")
+    return SimpleNamespace(choices=[choice], usage=None, model="fake")
+
+
+def _write_auto_config(home):
+    home.mkdir()
+    (home / "config.yaml").write_text(
+        """
+moa:
+  default_preset: default
+  presets:
+    auto_moa:
+      auto_route:
+        code: code_logic_deep
+        logic: logic_deep
+        code_visual: code_visual_deep
+        logic_visual: logic_visual_deep
+        fallback: default
+        context_messages: 8
+      reference_models:
+        - provider: test
+          model: placeholder-ref
+      aggregator:
+        provider: test
+        model: placeholder-agg
+    default:
+      reference_models:
+        - provider: test
+          model: default-ref
+      aggregator:
+        provider: test
+        model: default-agg
+    code_logic_deep:
+      reference_models:
+        - provider: test
+          model: code-ref
+      aggregator:
+        provider: test
+        model: code-agg
+    logic_deep:
+      reference_models:
+        - provider: test
+          model: logic-ref
+      aggregator:
+        provider: test
+        model: logic-agg
+    code_visual_deep:
+      reference_models:
+        - provider: test
+          model: code-visual-ref
+      aggregator:
+        provider: test
+        model: code-visual-agg
+    logic_visual_deep:
+      reference_models:
+        - provider: test
+          model: logic-visual-ref
+      aggregator:
+        provider: test
+        model: logic-visual-agg
+""".strip(),
+        encoding="utf-8",
+    )
+
+
+def test_auto_preset_executes_selected_code_preset(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    _write_auto_config(home)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    calls = []
+
+    def fake_call_llm(**kwargs):
+        calls.append((kwargs["task"], kwargs["model"]))
+        return _response("advice" if kwargs["task"] == "moa_reference" else "acted")
+
+    monkeypatch.setattr("agent.moa_loop.call_llm", fake_call_llm)
+
+    from agent.moa_loop import MoAChatCompletions
+
+    events = []
+    facade = MoAChatCompletions(
+        "auto_moa",
+        reference_callback=lambda event, **kwargs: events.append((event, kwargs)),
+    )
+    facade.create(
+        model="auto_moa",
+        messages=[{"role": "user", "content": "Исправь pytest regression в parser"}],
+    )
+
+    assert calls == [("moa_reference", "code-ref"), ("moa_aggregator", "code-agg")]
+    assert facade.last_aggregator_slot["model"] == "code-agg"
+    assert facade.last_resolved_preset_name == "code_logic_deep"
+    assert facade.last_auto_route_decision.reason == "code-signals"
+    assert ("moa.route", {"preset": "code_logic_deep", "reason": "code-signals"}) in events
+
+
+def test_auto_route_event_reaches_agent_progress_callback(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    _write_auto_config(home)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    def fake_call_llm(**kwargs):
+        return _response("advice" if kwargs["task"] == "moa_reference" else "acted")
+
+    monkeypatch.setattr("agent.moa_loop.call_llm", fake_call_llm)
+
+    from agent.moa_loop import build_moa_facade
+
+    progress = []
+    agent = SimpleNamespace(
+        model="auto_moa",
+        tool_progress_callback=lambda *args, **kwargs: progress.append((args, kwargs)),
+    )
+    client = build_moa_facade(agent, "auto_moa")
+    client.chat.completions.create(
+        model="auto_moa",
+        messages=[{"role": "user", "content": "Исправь pytest regression"}],
+    )
+
+    route_events = [event for event in progress if event[0][0] == "moa.route"]
+    assert len(route_events) == 1
+    args, kwargs = route_events[0]
+    assert args[1] == "code_logic_deep"
+    assert args[2] == "code-signals"
+    assert kwargs["moa_preset"] == "code_logic_deep"
+    assert kwargs["moa_reason"] == "code-signals"
+
+
+def test_auto_route_is_decided_once_across_tool_iterations(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    _write_auto_config(home)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    calls = []
+
+    def fake_call_llm(**kwargs):
+        calls.append((kwargs["task"], kwargs["model"]))
+        return _response("advice" if kwargs["task"] == "moa_reference" else "acted")
+
+    monkeypatch.setattr("agent.moa_loop.call_llm", fake_call_llm)
+
+    from agent.moa_loop import MoAChatCompletions
+
+    events = []
+    facade = MoAChatCompletions(
+        "auto_moa",
+        reference_callback=lambda event, **kwargs: events.append((event, kwargs)),
+    )
+    user_message = {"role": "user", "content": "Исправь pytest regression"}
+    facade.create(model="auto_moa", messages=[user_message])
+    facade.create(
+        model="auto_moa",
+        messages=[
+            user_message,
+            {"role": "assistant", "content": "Проверяю файл."},
+            {"role": "tool", "tool_call_id": "call-1", "content": "tool output"},
+        ],
+    )
+
+    assert [kwargs for event, kwargs in events if event == "moa.route"] == [
+        {"preset": "code_logic_deep", "reason": "code-signals"}
+    ]
+    assert calls == [
+        ("moa_reference", "code-ref"),
+        ("moa_aggregator", "code-agg"),
+        ("moa_aggregator", "code-agg"),
+    ]
+
+
+def test_auto_route_can_switch_on_a_new_user_turn(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    _write_auto_config(home)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    calls = []
+
+    def fake_call_llm(**kwargs):
+        calls.append((kwargs["task"], kwargs["model"]))
+        return _response("advice" if kwargs["task"] == "moa_reference" else "acted")
+
+    monkeypatch.setattr("agent.moa_loop.call_llm", fake_call_llm)
+
+    from agent.moa_loop import MoAChatCompletions
+
+    events = []
+    facade = MoAChatCompletions(
+        "auto_moa",
+        reference_callback=lambda event, **kwargs: events.append((event, kwargs)),
+    )
+    first_turn = {"role": "user", "content": "Исправь pytest regression"}
+    facade.create(model="auto_moa", messages=[first_turn])
+    facade.create(
+        model="auto_moa",
+        messages=[
+            first_turn,
+            {"role": "assistant", "content": "Исправление готово."},
+            {
+                "role": "user",
+                "content": "Теперь сравни стратегии принятия решений и обоснуй вывод",
+            },
+        ],
+    )
+
+    route_presets = [kwargs["preset"] for event, kwargs in events if event == "moa.route"]
+    assert route_presets == ["code_logic_deep", "logic_deep"]
+    assert calls[-2:] == [
+        ("moa_reference", "logic-ref"),
+        ("moa_aggregator", "logic-agg"),
+    ]
+
+
+def test_visual_auto_route_keeps_pixels_for_aggregator_only(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    _write_auto_config(home)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    calls = []
+
+    def fake_call_llm(**kwargs):
+        calls.append(kwargs)
+        return _response("advice" if kwargs["task"] == "moa_reference" else "acted")
+
+    monkeypatch.setattr("agent.moa_loop.call_llm", fake_call_llm)
+
+    from agent.moa_loop import MoAChatCompletions
+
+    facade = MoAChatCompletions("auto_moa")
+    facade.create(
+        model="auto_moa",
+        messages=[
+            {
+                "role": "user",
+                "content": [
+                    {"type": "text", "text": "Что изображено?"},
+                    {
+                        "type": "image_url",
+                        "image_url": {"url": "data:image/png;base64,AA=="},
+                    },
+                ],
+            }
+        ],
+    )
+
+    reference_call, aggregator_call = calls
+    assert reference_call["model"] == "logic-visual-ref"
+    assert "image_url" not in repr(reference_call["messages"])
+    assert aggregator_call["model"] == "logic-visual-agg"
+    assert "image_url" in repr(aggregator_call["messages"])
+    assert facade.last_resolved_preset_name == "logic_visual_deep"
+
+
+def test_auto_route_trace_records_requested_target_category_and_reason(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    _write_auto_config(home)
+    config_path = home / "config.yaml"
+    config_path.write_text(
+        config_path.read_text(encoding="utf-8").replace(
+            "moa:\n",
+            "moa:\n  save_traces: true\n",
+            1,
+        ),
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    def fake_call_llm(**kwargs):
+        return _response("advice" if kwargs["task"] == "moa_reference" else "acted")
+
+    monkeypatch.setattr("agent.moa_loop.call_llm", fake_call_llm)
