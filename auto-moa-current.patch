@@ -0,0 +1,132 @@
+"""Tests for the auto-MoA router and ``moa.route`` relay contract."""
+from __future__ import annotations
+
+import pytest
+
+from agent.moa_auto_router import (
+    AutoRouteDecision,
+    auto_route_turn_fingerprint,
+    select_auto_moa_route,
+)
+
+
+def _route(messages, auto_route):
+    return select_auto_moa_route(messages, auto_route)
+
+
+def test_auto_route_selects_code_category_for_code_tokens():
+    decision = _route(
+        [{"role": "user", "content": "refactor the python script"}],
+        {
+            "fallback": "default",
+            "code": "code_preset",
+            "logic": "logic_preset",
+            "code_visual": "plot_preset",
+            "logic_visual": "chart_preset",
+        },
+    )
+    assert decision.preset == "code_preset"
+    assert decision.category == "code"
+    assert decision.reason == "auto route → code"
+
+
+def test_auto_route_selects_logic_category_for_explain_tokens():
+    decision = _route(
+        [{"role": "user", "content": "explain why this fails"}],
+        {
+            "fallback": "default",
+            "code": "code_preset",
+            "logic": "logic_preset",
+            "code_visual": "plot_preset",
+            "logic_visual": "chart_preset",
+        },
+    )
+    assert decision.preset == "logic_preset"
+    assert decision.category == "logic"
+    assert decision.reason == "auto route → logic"
+
+
+def test_auto_route_selects_logic_visual_for_image_tokens():
+    decision = _route(
+        [{"role": "user", "content": "show me the screenshot"}],
+        {
+            "fallback": "default",
+            "code": "code_preset",
+            "logic": "logic_preset",
+            "code_visual": "plot_preset",
+            "logic_visual": "chart_preset",
+        },
+    )
+    assert decision.preset == "chart_preset"
+    assert decision.category == "logic_visual"
+    assert decision.reason == "auto route → logic_visual"
+
+
+def test_auto_route_selects_code_visual_for_chart_tokens():
+    decision = _route(
+        [{"role": "user", "content": "plot the results as a chart"}],
+        {
+            "fallback": "default",
+            "code": "code_preset",
+            "logic": "logic_preset",
+            "code_visual": "plot_preset",
+            "logic_visual": "chart_preset",
+        },
+    )
+    assert decision.preset == "plot_preset"
+    assert decision.category == "code_visual"
+    assert decision.reason == "auto route → code_visual"
+
+
+def test_auto_route_fallback_when_no_tokens_match():
+    decision = _route(
+        [{"role": "user", "content": "hello world"}],
+        {
+            "fallback": "default",
+            "code": "code_preset",
+            "logic": "logic_preset",
+            "code_visual": "plot_preset",
+            "logic_visual": "chart_preset",
+        },
+    )
+    assert decision.preset == "default"
+    assert decision.category == "fallback"
+    assert decision.reason == "auto route → fallback"
+
+
+def test_auto_route_uses_configured_fallback_preset():
+    decision = _route(
+        [{"role": "user", "content": "hello world"}],
+        {
+            "fallback": "balanced",
+            "code": "code_preset",
+            "logic": "logic_preset",
+            "code_visual": "plot_preset",
+            "logic_visual": "chart_preset",
+        },
+    )
+    assert decision.preset == "balanced"
+    assert decision.category == "fallback"
+    assert decision.reason == "auto route → fallback"
+
+
+def test_auto_route_fingerprint_is_deterministic():
+    messages = [{"role": "user", "content": "hello"}]
+    first = auto_route_turn_fingerprint(messages)
+    second = auto_route_turn_fingerprint(messages)
+    assert first == second
+    assert isinstance(first, str)
+    assert len(first) == 64
+
+
+def test_auto_route_fingerprint_changes_with_message_content():
+    first = auto_route_turn_fingerprint([{"role": "user", "content": "hello"}])
+    second = auto_route_turn_fingerprint([{"role": "user", "content": "world"}])
+    assert first != second
+
+
+def test_auto_route_decision_exposes_expected_fields():
+    decision = AutoRouteDecision(preset="x", category="code", reason="auto route → code")
+    assert decision.preset == "x"
+    assert decision.category == "code"
+    assert decision.reason == "auto route → code"
