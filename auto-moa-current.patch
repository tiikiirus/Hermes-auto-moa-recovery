+"""Deterministic, pre-inference routing for opt-in MoA auto presets."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from dataclasses import dataclass
+from typing import Any, Mapping, Sequence
+
+from agent.message_content import flatten_message_text
+
+
+_CODE_RE = re.compile(
+    r"(?ix)(?:"
+    r"\b(?:api|css|html|javascript|pytest|typescript|ui)\b|"
+    r"\b(?:bug|cod|compil|debug|exception|function|implement|refactor|regression|repositor|test)\w*|"
+    r"\bstack\s*trace\b|"
+    r"\b(?:баг|верст|интерфейс|исправ|код|компил|отлад|ошибк|падени|реализ|рефактор|репозитор|тест)\w*"
+    r")"
+)
+
+_SOURCE_FILE_RE = re.compile(
+    r"(?ix)\.(?:"
+    r"bash|c|cc|cpp|cs|css|go|graphql|h|hcl|hpp|html|java|js|json|jsx|kt|kts|"
+    r"less|php|proto|py|rb|rs|sass|scala|scss|sh|sql|svelte|swift|tf|toml|ts|tsx|"
+    r"vue|xml|ya?ml"
+    r")(?:\b|$)"
+)
+
+_CODE_FENCE_RE = re.compile(
+    r"(?i)```(?:bash|c|cpp|csharp|css|go|html|java|javascript|js|json|jsx|php|"
+    r"python|py|ruby|rust|sh|sql|swift|tsx?|typescript|vue|xml|ya?ml)\b"
+)
+
+_LOGIC_RE = re.compile(
+    r"(?ix)\b(?:"
+    r"analyse|analyze|architecture|compare|contradiction|deduce|evaluate|"
+    r"hypothesis|logic|plan|proof|reason|strategy|trade[- ]?off|"
+    r"анализ|архитектур|вывод|гипотез|доказ|логик|обосну|план|"
+    r"противореч|сравн|стратег"
+    r")\w*"
+)
+
+_FOLLOW_UP_RE = re.compile(
+    r"(?ix)^\s*(?:"
+    r"continue|proceed|go\s+on|keep\s+going|carry\s+on|do\s+(?:it|that)|"
+    r"same(?:\s+thing)?|again|"
+    r"продолж\w*|дальше|доработ\w*|сделай\s+это|так\s+же|ещ[её]"
+    r")\b"
+)
+
+_VISUAL_PART_TYPES = {
+    "image",
+    "image_url",
+    "input_image",
+    "input_video",
+    "video",
+    "video_url",
+}
+
+
+@dataclass(frozen=True)
+class MoARouteDecision:
+    """Resolved semantic category and concrete MoA preset."""
+
+    category: str
+    preset: str
+    reason: str
+
+
+def _text_content(content: Any) -> str:
+    return flatten_message_text(content)
+
+
+def _has_visual_content(content: Any) -> bool:
+    if isinstance(content, Mapping):
+        return str(content.get("type") or "").lower() in _VISUAL_PART_TYPES
+    if not isinstance(content, (list, tuple)):
+        return False
+    return any(
+        isinstance(item, Mapping)
+        and str(item.get("type") or "").lower() in _VISUAL_PART_TYPES
+        for item in content
+    )
+
+
+def auto_route_turn_fingerprint(messages: Sequence[Mapping[str, Any]]) -> str:
+    """Best-effort stable identity for direct callers without a canonical turn ID."""
+    user_messages = [message for message in messages if message.get("role") == "user"]
+    latest = user_messages[-1] if user_messages else {}
+    content = latest.get("content")
+    visual_parts: list[dict[str, Any]] = []
+    content_parts = (
+        [content]
+        if isinstance(content, Mapping)
+        else content
+        if isinstance(content, (list, tuple))
+        else []
+    )
+    if content_parts:
+        for part in content_parts:
+            if not isinstance(part, Mapping):
+                continue
+            if str(part.get("type") or "").lower() not in _VISUAL_PART_TYPES:
+                continue
+            visual_parts.append(
+                {key: value for key, value in part.items() if key != "cache_control"}
+            )
+    semantic_turn = (
+        len(user_messages),
+        flatten_message_text(content),
+        visual_parts,
+    )
+    return hashlib.sha256(repr(semantic_turn).encode("utf-8", "replace")).hexdigest()
+
+
+def _routed_category(base: str, has_visual: bool) -> str:
+    semantic_base = "code" if base.startswith("code") else "logic"
+    if not has_visual:
+        return semantic_base
+    return f"{semantic_base}_visual"
+
+
+def _has_code_signals(text: str) -> bool:
+    return bool(
+        _CODE_RE.search(text)
+        or _SOURCE_FILE_RE.search(text)
+        or _CODE_FENCE_RE.search(text)
+    )
+
+
+def select_auto_moa_route(
+    messages: Sequence[Mapping[str, Any]],
+    routes: Mapping[str, Any],
+    *,
+    previous_category: str | None = None,
+) -> MoARouteDecision:
+    """Choose a concrete preset before any model call is made."""
+
+    latest_user_index = next(
+        (
+            index
+            for index in range(len(messages) - 1, -1, -1)
+            if messages[index].get("role") == "user"
+        ),
+        -1,
+    )
+    latest_user = messages[latest_user_index] if latest_user_index >= 0 else {}
+    try:
+        context_limit = max(1, min(20, int(routes.get("context_messages", 8))))
+    except (TypeError, ValueError):
+        context_limit = 8
+    context_messages = [
+        message
+        for message in messages[:latest_user_index]
+        if message.get("role") in {"user", "assistant"}
+    ][-context_limit:]
+    text = _text_content(latest_user.get("content"))
+    is_contextual_follow_up = bool(_FOLLOW_UP_RE.search(text))
+    context_text = "\n".join(
+        _text_content(message.get("content")) for message in context_messages
+    )
+    latest_has_visual = _has_visual_content(latest_user.get("content"))
+    context_has_visual = any(
+        message.get("role") == "user"
+        and _has_visual_content(message.get("content"))
+        for message in context_messages
+    )
+    has_visual = latest_has_visual or (
+        is_contextual_follow_up and context_has_visual
+    )
+    if _has_code_signals(text):
+        category = _routed_category("code", has_visual)
+        reason = "visual-context+code-signals" if has_visual else "code-signals"
+        return MoARouteDecision(category, str(routes[category]), reason)
+    if _LOGIC_RE.search(text):
+        category = _routed_category("logic", has_visual)
+        reason = "visual-context+logic-signals" if has_visual else "logic-signals"
+        return MoARouteDecision(category, str(routes[category]), reason)
+    if is_contextual_follow_up and previous_category in {
+        "code",
+        "logic",
+        "code_visual",
+        "logic_visual",
+    }:
+        category = _routed_category(previous_category, has_visual)
+        return MoARouteDecision(
+            category,
+            str(routes[category]),
+            f"sticky-{category}",
+        )
+    if is_contextual_follow_up and _has_code_signals(context_text):
+        category = _routed_category("code", has_visual)
+        reason = (
+            "visual-context+context-code-signals"
+            if has_visual
+            else "context-code-signals"
+        )
+        return MoARouteDecision(category, str(routes[category]), reason)
+    if is_contextual_follow_up and _LOGIC_RE.search(context_text):
+        category = _routed_category("logic", has_visual)
+        reason = (
+            "visual-context+context-logic-signals"
+            if has_visual
+            else "context-logic-signals"
+        )
+        return MoARouteDecision(category, str(routes[category]), reason)
+    if has_visual:
+        return MoARouteDecision(
+            "logic_visual",
+            str(routes["logic_visual"]),
+            "visual-context",
+        )
+    return MoARouteDecision("fallback", str(routes["fallback"]), "fallback")
