diff --git a/tests/agent/test_moa_auto_router.py b/tests/agent/test_moa_auto_router.py
new file mode 100644
index 000000000..023369cc4
--- /dev/null
+++ b/tests/agent/test_moa_auto_router.py
@@ -0,0 +1,235 @@
+from agent.moa_auto_router import select_auto_moa_route
+
+
+ROUTES = {
+    "code": "code_logic_deep",
+    "logic": "logic_deep",
+    "code_visual": "code_visual_deep",
+    "logic_visual": "logic_visual_deep",
+    "fallback": "default",
+}
+
+
+def test_code_task_routes_to_code_preset():
+    decision = select_auto_moa_route(
+        [{"role": "user", "content": "Исправь падение pytest и добавь regression test"}],
+        ROUTES,
+    )
+
+    assert decision.category == "code"
+    assert decision.preset == "code_logic_deep"
+    assert decision.reason == "code-signals"
+
+
+def test_reasoning_task_routes_to_logic_preset():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "user",
+                "content": "Сравни архитектурные варианты, найди противоречия и обоснуй вывод",
+            }
+        ],
+        ROUTES,
+    )
+
+    assert decision.category == "logic"
+    assert decision.preset == "logic_deep"
+    assert decision.reason == "logic-signals"
+
+
+def test_visual_code_task_routes_to_code_visual_preset():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "user",
+                "content": [
+                    {"type": "text", "text": "Сверстай этот UI и исправь CSS"},
+                    {
+                        "type": "image_url",
+                        "image_url": {"url": "data:image/png;base64,AA=="},
+                    },
+                ],
+            }
+        ],
+        ROUTES,
+    )
+
+    assert decision.category == "code_visual"
+    assert decision.preset == "code_visual_deep"
+    assert decision.reason == "visual-context+code-signals"
+
+
+def test_generic_visual_task_routes_to_logic_visual_preset():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "user",
+                "content": [
+                    {"type": "text", "text": "Что здесь происходит?"},
+                    {"type": "input_image", "image_url": "file:///diagram.png"},
+                ],
+            }
+        ],
+        ROUTES,
+    )
+
+    assert decision.category == "logic_visual"
+    assert decision.preset == "logic_visual_deep"
+    assert decision.reason == "visual-context"
+
+
+def test_ambiguous_follow_up_keeps_previous_code_category():
+    decision = select_auto_moa_route(
+        [{"role": "user", "content": "Продолжай и сделай аккуратно"}],
+        ROUTES,
+        previous_category="code",
+    )
+
+    assert decision.category == "code"
+    assert decision.preset == "code_logic_deep"
+    assert decision.reason == "sticky-code"
+
+
+def test_ambiguous_first_turn_uses_recent_conversation_context():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "system",
+                "content": "You are a coding agent. Always mention pytest.",
+            },
+            {"role": "user", "content": "Найди баг в Python parser"},
+            {"role": "assistant", "content": "Причина найдена."},
+            {"role": "user", "content": "Продолжай и сделай аккуратно"},
+        ],
+        ROUTES,
+    )
+
+    assert decision.category == "code"
+    assert decision.preset == "code_logic_deep"
+    assert decision.reason == "context-code-signals"
+
+
+def test_russian_inflected_code_terms_route_to_code_preset():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "user",
+                "content": "Проанализируй архитектуру репозитория, исправь ошибку в реализации и добавь тесты.",
+            }
+        ],
+        ROUTES,
+    )
+
+    assert decision.preset == "code_logic_deep"
+    assert decision.category == "code"
+
+
+def test_source_file_path_routes_to_code_preset():
+    decision = select_auto_moa_route(
+        [{"role": "user", "content": "Проверь src/components/Button.tsx около строки 42"}],
+        ROUTES,
+    )
+
+    assert decision.preset == "code_logic_deep"
+    assert decision.category == "code"
+
+
+def test_fenced_source_routes_to_code_preset():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "user",
+                "content": "Что здесь не так?\n```python\nvalue = items[0]\n```",
+            }
+        ],
+        ROUTES,
+    )
+
+    assert decision.preset == "code_logic_deep"
+    assert decision.category == "code"
+
+
+def test_visual_stickiness_downgrades_after_visual_context_expires():
+    decision = select_auto_moa_route(
+        [{"role": "user", "content": "Продолжай аккуратно"}],
+        ROUTES,
+        previous_category="code_visual",
+    )
+
+    assert decision.preset == "code_logic_deep"
+    assert decision.category == "code"
+
+
+def test_previous_category_does_not_hijack_a_new_self_contained_task():
+    decision = select_auto_moa_route(
+        [
+            {"role": "user", "content": "Исправь parser.py"},
+            {"role": "assistant", "content": "Готово."},
+            {"role": "user", "content": "Напиши короткое дружелюбное приветствие"},
+        ],
+        ROUTES,
+        previous_category="code",
+    )
+
+    assert decision.preset == "default"
+    assert decision.category == "fallback"
+
+
+def test_input_text_part_participates_in_visual_code_routing():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "user",
+                "content": [
+                    {"type": "input_text", "text": "Исправь CSS этого UI"},
+                    {"type": "input_image", "image_url": "data:image/png;base64,AA=="},
+                ],
+            }
+        ],
+        ROUTES,
+    )
+
+    assert decision.preset == "code_visual_deep"
+    assert decision.category == "code_visual"
+
+
+def test_single_visual_content_part_uses_visual_route():
+    decision = select_auto_moa_route(
+        [
+            {
+                "role": "user",
+                "content": {
+                    "type": "input_image",
+                    "image_url": "data:image/png;base64,AA==",
+                },
+            }
+        ],
+        ROUTES,
+    )
