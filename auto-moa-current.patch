+    direction and unpinned/disabled slots keep their default/global path:
+    - "trivial": downgrade-only (advisors→low, aggregator→medium).
+    - "complex": upgrade-only (advisors one notch, cap high; aggregator→xhigh).
+    - "standard"/unknown: untouched copies.
+    Never mutates the inputs — preset config must not leak across turns.
+    """
+    refs = [dict(slot) for slot in (reference_models or [])]
+    agg = dict(aggregator or {})
+    if complexity == "trivial":
+        for slot in refs:
+            idx = _effort_index(slot.get("reasoning_effort"))
+            if idx is not None and idx > _EFFORT_ORDER.index("low"):
+                slot["reasoning_effort"] = "low"
+        if "reasoning_effort" in agg:
+            idx = _effort_index(agg.get("reasoning_effort"))
+            if idx is not None and idx > _EFFORT_ORDER.index("medium"):
+                agg["reasoning_effort"] = "medium"
+    elif complexity == "complex":
+        for slot in refs:
+            idx = _effort_index(slot.get("reasoning_effort"))
+            if idx is not None:
