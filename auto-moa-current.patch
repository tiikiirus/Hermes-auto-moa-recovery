index 000000000..48f6285bf
--- /dev/null
+++ b/tests/agent/test_moa_empty_reference.py
@@ -0,0 +1,42 @@
+"""Empty advisor replies must not reach the aggregator as advice.
+
+Observed on free-tier models across consecutive turns: HTTP 200 with no
+content, normalized to the "(empty response)" placeholder, which used to
+flow into the fan-in as if it were real guidance.
+"""
+
+from agent.moa_loop import _failed_reference_labels, _is_failed_reference, _successful_references
+
+
+def _out(label, text):
+    return (label, text, object())
+
+
+def test_empty_placeholder_is_failed():
+    assert _is_failed_reference("(empty response)") is True
+
+
+def test_empty_placeholder_exact_contract():
+    # The placeholder is produced verbatim by _run_reference; matching is
+    # intentionally exact so real advice is never misclassified.
+    assert _is_failed_reference("(empty response)") is True
+
+
+def test_real_advice_is_not_failed():
+    assert _is_failed_reference("The page shows 16 duplicate channels.") is False
+
+
+def test_existing_sentinels_still_failed():
+    assert _is_failed_reference("[failed: timeout]") is True
+    assert _is_failed_reference("[skipped: recursion guard]") is True
+
+
+def test_successful_references_drops_empty_keeps_real():
+    outputs = [
+        _out("a", "(empty response)"),
+        _out("b", "Real advice here."),
+        _out("c", "[failed: boom]"),
+    ]
+    kept = _successful_references(outputs)
+    assert [label for label, _, _ in kept] == ["b"]
+    assert _failed_reference_labels(outputs) == ["a", "c"]
