+def _response(content: str):
+    message = SimpleNamespace(content=content, tool_calls=[])
+    choice = SimpleNamespace(message=message, finish_reason="stop")
+    return SimpleNamespace(choices=[choice], usage=None, model="fake")
+
+
+def _write_auto_config(home):
+    home.mkdir()
+    (home / "config.yaml").write_text(
+        """
+moa:
+  default_preset: default
+  presets:
+    auto_moa:
+      auto_route:
+        code: code_logic_deep
+        logic: logic_deep
+        code_visual: code_visual_deep
+        logic_visual: logic_visual_deep
+        fallback: default
+        context_messages: 8
+      reference_models:
+        - provider: test
+          model: placeholder-ref
+      aggregator:
+        provider: test
+        model: placeholder-agg
+    default:
+      reference_models:
+        - provider: test
+          model: default-ref
+      aggregator:
+        provider: test
+        model: default-agg
+    code_logic_deep:
+      reference_models:
+        - provider: test
+          model: code-ref
+      aggregator:
+        provider: test
+        model: code-agg
+    logic_deep:
+      reference_models:
+        - provider: test
+          model: logic-ref
+      aggregator:
+        provider: test
+        model: logic-agg
+    code_visual_deep:
+      reference_models:
+        - provider: test
+          model: code-visual-ref
+      aggregator:
+        provider: test
+        model: code-visual-agg
+    logic_visual_deep:
+      reference_models:
+        - provider: test
+          model: logic-visual-ref
+      aggregator:
+        provider: test
+        model: logic-visual-agg
+""".strip(),
+        encoding="utf-8",
+    )
